<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TextToSqlUi</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../../components/frontend/text-to-sql-ui/Services/SqlQueryPolicy.cs" Link="SqlQueryPolicy.cs" />
    <Compile Include="../../components/frontend/text-to-sql-ui/Services/SqlResultReader.cs" Link="SqlResultReader.cs" />
    <Compile Include="../../components/frontend/text-to-sql-ui/Services/RuleBasedLlmClient.cs" Link="RuleBasedLlmClient.cs" />
    <Compile Include="../../components/frontend/text-to-sql-ui/Services/ILlmClient.cs" Link="ILlmClient.cs" />
    <Compile Include="../../components/frontend/text-to-sql-ui/Services/ServiceMessages.cs" Link="ServiceMessages.cs" />
    <EmbeddedResource Include="../../components/frontend/text-to-sql-ui/Services/ServiceMessages*.resx" Link="Services/%(Filename)%(Extension)" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
</Project>
